{
  "version": 2,
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron-check-alerts",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/inventory", "destination": "/dashboard.html" },
    { "source": "/add-item", "destination": "/dashboard.html" },
    { "source": "/scan", "destination": "/dashboard.html" },
    { "source": "/billing-scan", "destination": "/dashboard.html" },
    { "source": "/billing", "destination": "/dashboard.html" },
    { "source": "/expiry-calendar", "destination": "/dashboard.html" },
    { "source": "/shopping-list", "destination": "/dashboard.html" },
    { "source": "/recipes", "destination": "/dashboard.html" },
    { "source": "/insights", "destination": "/dashboard.html" },
    { "source": "/notifications", "destination": "/dashboard.html" },
    { "source": "/settings", "destination": "/dashboard.html" },
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/", "destination": "/dashboard.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
